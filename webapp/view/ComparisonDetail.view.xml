<mvc:View
  controllerName="abap.to.fiori.system.controller.ComparisonDetail"
  xmlns:mvc="sap.ui.core.mvc"
  xmlns:core="sap.ui.core"
  xmlns:uxap="sap.uxap"
  xmlns="sap.m"
  displayBlock="true">
  <uxap:ObjectPageLayout
    id="comparisonDetailPage"
    busy="{comparisonUi>/busy}"
    busyIndicatorDelay="0"
    class="migrationAnalyzerObjectPage"
    useIconTabBar="false"
    showFooter="false">
    <uxap:headerTitle>
      <uxap:ObjectPageDynamicHeaderTitle>
        <uxap:heading>
          <HBox class="pageTitleWithBack">
            <Button icon="sap-icon://nav-back" tooltip="{i18n>back}" type="Transparent" press=".onBackToHistory" />
            <VBox>
              <Title text="{path: 'comparisonUi>/run/ProgramName', formatter: '.comparisonFormatter.formatText'}" level="H1" />
              <ObjectStatus
                text="{path: 'comparisonUi>/run/RunStatus', formatter: '.comparisonFormatter.formatText'}"
                state="{path: 'comparisonUi>/run/RunStatus', formatter: '.comparisonFormatter.statusToValueState'}"
                icon="sap-icon://compare" />
            </VBox>
          </HBox>
        </uxap:heading>
        <uxap:expandedHeading>
          <HBox wrap="Wrap" class="detailMetaLine">
            <ObjectAttribute title="{i18n>comparisonRunId}" text="{path: 'comparisonUi>/run/CmpRunId', formatter: '.comparisonFormatter.formatText'}" />
            <ObjectAttribute title="{i18n>analysisId}" text="{path: 'comparisonUi>/run/AnalysisId', formatter: '.comparisonFormatter.formatText'}" />
            <ObjectAttribute title="{i18n>createdAt}" text="{path: 'comparisonUi>/run/CreatedAt', formatter: '.comparisonFormatter.formatDateTime'}" />
          </HBox>
        </uxap:expandedHeading>
        <uxap:actions>
          <Button icon="sap-icon://refresh" tooltip="{i18n>refresh}" press=".onRefresh" />
        </uxap:actions>
      </uxap:ObjectPageDynamicHeaderTitle>
    </uxap:headerTitle>
    <uxap:headerContent>
      <HBox wrap="Wrap" class="detailOverviewMetrics">
        <VBox class="migrationAnalyzerMetric">
          <Label text="{i18n>compatibilityRate}" />
          <ObjectNumber number="{path: 'comparisonUi>/run/CompatibilityRate', formatter: '.comparisonFormatter.formatCompatibilityRate'}" unit="%" />
        </VBox>
        <VBox class="migrationAnalyzerMetric">
          <Label text="{i18n>totalItems}" />
          <ObjectNumber number="{path: 'comparisonUi>/run/TotalItems', formatter: '.comparisonFormatter.formatCount'}" />
        </VBox>
        <VBox class="migrationAnalyzerMetric">
          <Label text="{i18n>mappedCount}" />
          <ObjectNumber number="{path: 'comparisonUi>/run/MappedCount', formatter: '.comparisonFormatter.formatCount'}" />
        </VBox>
        <VBox class="migrationAnalyzerMetric">
          <Label text="{i18n>refactorCount}" />
          <ObjectNumber number="{path: 'comparisonUi>/run/RefactorCount', formatter: '.comparisonFormatter.formatCount'}" />
        </VBox>
        <VBox class="migrationAnalyzerMetric">
          <Label text="{i18n>manualCount}" />
          <ObjectNumber number="{path: 'comparisonUi>/run/ManualCount', formatter: '.comparisonFormatter.formatCount'}" />
        </VBox>
        <VBox class="migrationAnalyzerMetric">
          <Label text="{i18n>unsupportedCount}" />
          <ObjectNumber number="{path: 'comparisonUi>/run/UnsupportedCount', formatter: '.comparisonFormatter.formatCount'}" />
        </VBox>
      </HBox>
    </uxap:headerContent>
    <uxap:sections>
      <uxap:ObjectPageSection title="{i18n>comparisonItems}">
        <uxap:subSections>
          <uxap:ObjectPageSubSection title="{i18n>comparisonItems}">
            <uxap:blocks>
              <VBox class="migrationAnalyzerContent">
                <MessageStrip
                  text="{comparisonUi>/errorMessage}"
                  type="Error"
                  showIcon="true"
                  visible="{= !!${comparisonUi>/errorMessage} }" />
                <HBox alignItems="End" wrap="Wrap" class="migrationAnalyzerFilterBar">
                  <VBox class="migrationAnalyzerFilterField migrationAnalyzerSelectFilterField">
                    <Label text="{i18n>category}" labelFor="comparisonItemCategory" />
                    <Input id="comparisonItemCategory" value="{comparisonUi>/itemFilters/category}" submit=".onItemFilterChange" />
                  </VBox>
                  <VBox class="migrationAnalyzerFilterField migrationAnalyzerSelectFilterField">
                    <Label text="{i18n>status}" labelFor="comparisonItemStatus" />
                    <Input id="comparisonItemStatus" value="{comparisonUi>/itemFilters/status}" submit=".onItemFilterChange" />
                  </VBox>
                  <VBox class="migrationAnalyzerFilterField migrationAnalyzerSelectFilterField">
                    <Label text="{i18n>severity}" labelFor="comparisonItemSeverity" />
                    <Input id="comparisonItemSeverity" value="{comparisonUi>/itemFilters/severity}" submit=".onItemFilterChange" />
                  </VBox>
                </HBox>
                <Table
                  id="comparisonItemsTable"
                  growing="true"
                  growingThreshold="50"
                  sticky="ColumnHeaders"
                  itemPress=".onItemPress"
                  items="{comparisonUi>/items}">
                  <noData>
                    <IllustratedMessage
                      illustrationType="sapIllus-NoEntries"
                      title="{i18n>noComparisonItems}"
                      description="{i18n>noComparisonItemsDescription}" />
                  </noData>
                  <columns>
                    <Column width="5rem" hAlign="End"><Text text="{i18n>itemNo}" /></Column>
                    <Column width="10rem"><Text text="{i18n>category}" /></Column>
                    <Column width="12rem"><Text text="{i18n>sourceElement}" /></Column>
                    <Column width="10rem" demandPopin="true" minScreenWidth="Tablet"><Text text="{i18n>sourceType}" /></Column>
                    <Column width="12rem"><Text text="{i18n>targetElement}" /></Column>
                    <Column width="10rem" demandPopin="true" minScreenWidth="Tablet"><Text text="{i18n>targetType}" /></Column>
                    <Column width="9rem"><Text text="{i18n>status}" /></Column>
                    <Column width="9rem"><Text text="{i18n>severity}" /></Column>
                    <Column demandPopin="true" minScreenWidth="Desktop"><Text text="{i18n>messageText}" /></Column>
                  </columns>
                  <items>
                    <ColumnListItem type="Navigation" press=".onItemPress">
                      <cells>
                        <ObjectNumber number="{path: 'comparisonUi>ItemNo', formatter: '.comparisonFormatter.formatCount'}" />
                        <Text text="{path: 'comparisonUi>Category', formatter: '.comparisonFormatter.formatText'}" />
                        <Text text="{path: 'comparisonUi>SourceElement', formatter: '.comparisonFormatter.formatText'}" />
                        <Text text="{path: 'comparisonUi>SourceType', formatter: '.comparisonFormatter.formatText'}" />
                        <Text text="{path: 'comparisonUi>TargetElement', formatter: '.comparisonFormatter.formatText'}" />
                        <Text text="{path: 'comparisonUi>TargetType', formatter: '.comparisonFormatter.formatText'}" />
                        <ObjectStatus text="{path: 'comparisonUi>Status', formatter: '.comparisonFormatter.formatText'}" state="{path: 'comparisonUi>Status', formatter: '.comparisonFormatter.statusToValueState'}" />
                        <ObjectStatus text="{path: 'comparisonUi>Severity', formatter: '.comparisonFormatter.formatText'}" state="{path: 'comparisonUi>Severity', formatter: '.comparisonFormatter.statusToValueState'}" />
                        <Text text="{path: 'comparisonUi>Message', formatter: '.comparisonFormatter.formatText'}" />
                      </cells>
                    </ColumnListItem>
                  </items>
                </Table>
              </VBox>
            </uxap:blocks>
          </uxap:ObjectPageSubSection>
        </uxap:subSections>
      </uxap:ObjectPageSection>
    </uxap:sections>
  </uxap:ObjectPageLayout>
</mvc:View>
