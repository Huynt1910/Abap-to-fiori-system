<mvc:View
  controllerName="abap.to.fiori.system.controller.Dashboard"
  xmlns:mvc="sap.ui.core.mvc"
  xmlns:core="sap.ui.core"
  xmlns:f="sap.f"
  xmlns="sap.m"
  displayBlock="true">
  <f:DynamicPage id="dashboardPage" class="migrationDashboard">
    <f:title>
      <f:DynamicPageTitle>
        <f:heading>
          <Title text="{i18n>dashboardTitle}" level="H2" />
        </f:heading>
        <f:expandedContent>
          <ObjectStatus text="{path: 'dashboard>/visibleCount', formatter: '.formatter.formatCountText'}" />
        </f:expandedContent>
        <f:actions>
          <Button text="{i18n>runAnalysis}" type="Emphasized" icon="sap-icon://begin" press=".onRunAnalysis" />
          <Button text="{i18n>refresh}" icon="sap-icon://refresh" press=".onRefresh" />
        </f:actions>
      </f:DynamicPageTitle>
    </f:title>
    <f:header>
      <f:DynamicPageHeader pinnable="false">
        <HBox alignItems="End" wrap="Wrap" class="filterBar">
          <VBox class="filterField">
            <Label text="{i18n>rootProgram}" labelFor="programSearch" />
            <SearchField
              id="programSearch"
              value="{dashboard>/filters/search}"
              placeholder="{i18n>searchRootProgram}"
              search=".onSearch" />
          </VBox>
          <VBox class="filterField">
            <Label text="{i18n>analysisStatus}" labelFor="statusSelect" />
            <Select id="statusSelect" selectedKey="{dashboard>/filters/status}" change=".onSearch">
              <items>
                <core:Item key="" text="{i18n>allStatuses}" />
                <core:Item key="COMPLETED" text="{i18n>statusCompleted}" />
                <core:Item key="RUNNING" text="{i18n>statusRunning}" />
                <core:Item key="FAILED" text="{i18n>statusFailed}" />
              </items>
            </Select>
          </VBox>
          <CheckBox text="{i18n>latestOnly}" selected="{dashboard>/filters/latestOnly}" select=".onSearch" />
          <Button text="{i18n>clearFilters}" icon="sap-icon://clear-filter" press=".onClearFilters" />
        </HBox>
      </f:DynamicPageHeader>
    </f:header>
    <f:content>
      <VBox class="contentSurface">
        <Table
          id="analysisTable"
          growing="true"
          growingThreshold="20"
          growingScrollToLoad="true"
          sticky="ColumnHeaders"
          mode="None"
          itemPress=".onAnalysisPress"
          updateFinished=".onAnalysesUpdateFinished"
          noDataText="{i18n>noAnalyses}"
          items="{
            path: '/Analysis',
            parameters: {
              $select: 'AnalysisId,RootProgram,RunNo,IsLatest,AnalysisStatus,CreatedAt,CreatedBy,SourceLineCount,SourceObjectCount,IssueCount,WarningCount,StatusCriticality,WarningCriticality'
            },
            sorter: {
              path: 'CreatedAt',
              descending: true
            }
          }">
          <columns>
            <Column width="12rem" importance="High"><Text text="{i18n>rootProgram}" /></Column>
            <Column width="5rem" hAlign="End" importance="High"><Text text="{i18n>runNo}" /></Column>
            <Column width="9rem" importance="High"><Text text="{i18n>analysisStatus}" /></Column>
            <Column width="7rem" hAlign="End" demandPopin="true" minScreenWidth="Tablet"><Text text="{i18n>sourceLines}" /></Column>
            <Column width="7rem" hAlign="End" demandPopin="true" minScreenWidth="Tablet"><Text text="{i18n>sourceObjects}" /></Column>
            <Column width="6rem" hAlign="End" demandPopin="true" minScreenWidth="Tablet"><Text text="{i18n>issues}" /></Column>
            <Column width="6rem" hAlign="End" demandPopin="true" minScreenWidth="Tablet"><Text text="{i18n>warnings}" /></Column>
            <Column width="12rem" demandPopin="true" minScreenWidth="Desktop"><Text text="{i18n>createdAt}" /></Column>
            <Column width="10rem" demandPopin="true" minScreenWidth="Desktop"><Text text="{i18n>createdBy}" /></Column>
          </columns>
          <items>
            <ColumnListItem type="Navigation" press=".onAnalysisPress">
              <cells>
                <ObjectIdentifier title="{path: 'RootProgram', formatter: '.formatter.formatText'}" />
                <ObjectNumber number="{path: 'RunNo', formatter: '.formatter.formatNumber'}" />
                <ObjectStatus text="{path: 'AnalysisStatus', formatter: '.formatter.formatText'}" state="{path: 'StatusCriticality', formatter: '.formatter.formatCriticalityState'}" />
                <ObjectNumber number="{path: 'SourceLineCount', formatter: '.formatter.formatNumber'}" />
                <ObjectNumber number="{path: 'SourceObjectCount', formatter: '.formatter.formatNumber'}" />
                <ObjectNumber number="{path: 'IssueCount', formatter: '.formatter.formatNumber'}" state="Error" />
                <ObjectNumber number="{path: 'WarningCount', formatter: '.formatter.formatNumber'}" state="Warning" />
                <Text text="{path: 'CreatedAt', formatter: '.formatter.formatDateTime'}" />
                <Text text="{path: 'CreatedBy', formatter: '.formatter.formatText'}" />
              </cells>
            </ColumnListItem>
          </items>
        </Table>
      </VBox>
    </f:content>
  </f:DynamicPage>
</mvc:View>
