<mvc:View xmlns:mvc="sap.ui.core.mvc" xmlns="sap.m" controllerName="abap.to.fiori.system.controller.Modernization" displayBlock="true">
  <Page title="Modernization workspace" showNavButton="true" navButtonPress=".onBack" busy="{work>/busy}" busyIndicatorDelay="0">
    <content>
      <VBox class="sapUiResponsiveContentPadding sapUiSmallMargin">
        <ObjectIdentifier title="{work>/overview/ProgramName}" text="AI assessment, Fiori preparation and analysis conversations" />
        <MessageStrip class="sapUiSmallMarginTop" type="Error" showIcon="true" visible="{= !!${work>/error} }" text="{work>/error}" />
        <IconTabBar expandable="false" class="sapUiSmallMarginTop">
          <items>
            <IconTabFilter text="AI &amp; Fiori" icon="sap-icon://lightbulb">
              <VBox class="sapUiSmallMargin">
                <OverflowToolbar>
                  <Title text="Generate insights" level="H3" /><ToolbarSpacer />
                  <Button text="AI assessment" icon="sap-icon://lightbulb" press=".onAssess" enabled="{= ${auth>/canAnalyze} &amp;&amp; ${work>/overview/__OperationControl/GenerateAIAssessment} === true }" />
                  <Button text="Technical document" icon="sap-icon://document-text" press=".onTechnical" enabled="{= ${auth>/canExport} &amp;&amp; ${work>/overview/__OperationControl/GenerateTechnicalDocument} === true }" />
                </OverflowToolbar>
                <Panel headerText="Prepare Fiori UI" class="sapUiSmallMarginTop" expandable="true" expanded="true">
                  <VBox class="sapUiSmallMargin">
                    <Label text="Target ABAP package" labelFor="targetPackage" /><Input id="targetPackage" value="{work>/package}" maxLength="30" placeholder="Enter target package" />
                    <Label text="OData service root URL" labelFor="targetServiceRoot" class="sapUiSmallMarginTop" /><Input id="targetServiceRoot" value="{work>/serviceRoot}" placeholder="/sap/opu/odata4/.../0001/" />
                    <Button text="Prepare Fiori UI" type="Emphasized" class="sapUiSmallMarginTop" press=".onPrepareUi" enabled="{= ${auth>/canAnalyze} &amp;&amp; ${work>/overview/__OperationControl/PrepareFioriUi} === true }" />
                  </VBox>
                </Panel>
                <VBox items="{work>/results}" class="sapUiSmallMarginTop">
                  <Panel headerText="{work>label}" expandable="true" expanded="true" class="sapUiSmallMarginBottom"><Text text="{work>value}" wrapping="true" class="modernizationResultText" /></Panel>
                </VBox>
              </VBox>
            </IconTabFilter>
            <IconTabFilter text="Conversations" icon="sap-icon://discussion-2">
              <VBox class="sapUiSmallMargin">
                <Label text="Session name" labelFor="sessionName" /><Input id="sessionName" value="{work>/sessionName}" />
                <OverflowToolbar><Button text="New conversation" press=".onCreateSession" enabled="{auth>/canAnalyze}" /><Button text="Refresh" press=".onRefreshSessions" /><ToolbarSpacer />
                  <Button text="Rename" press=".onRenameSession" enabled="{= ${auth>/canAnalyze} &amp;&amp; !!${work>/sessionId} &amp;&amp; ${work>/selectedSession/__EntityControl/Updatable} === true }" />
                  <Button text="Delete" press=".onDeleteSession" enabled="{= ${auth>/canAnalyze} &amp;&amp; !!${work>/sessionId} &amp;&amp; ${work>/selectedSession/__EntityControl/Deletable} === true }" />
                </OverflowToolbar>
                <List items="{work>/sessions}" mode="SingleSelectMaster" selectionChange=".onSessionChange" noDataText="No conversations yet."><StandardListItem title="{work>SessionName}" description="{work>CreatedAt}" info="{work>Status}" selected="{= ${work>SessionId} === ${work>/sessionId} }" /></List>
                <Button text="Load more conversations" visible="{work>/moreSessions}" press=".onMoreSessions" />
                <VBox visible="{= !!${work>/sessionId} }" class="sapUiSmallMarginTop">
                  <Label text="Question about this analysis" labelFor="chatQuestion" /><TextArea id="chatQuestion" value="{work>/question}" width="100%" rows="3" />
                  <OverflowToolbar><Button text="Send question" type="Emphasized" press=".onAsk" enabled="{= ${auth>/canAnalyze} &amp;&amp; ${work>/selectedSession/__OperationControl/ask} === true &amp;&amp; !!${work>/question} }" /><Button text="Refresh messages" press=".onRefreshMessages" /></OverflowToolbar>
                  <List items="{work>/messages}" showSeparators="None" noDataText="Send a question to start the conversation.">
                    <CustomListItem><VBox class="sapUiSmallMargin"><ObjectStatus text="{work>Role}" /><Text text="{work>Content}" wrapping="true" class="modernizationResultText" /><ObjectStatus text="Outdated analysis context" state="Warning" visible="{work>IsOutdated}" /><Text text="{work>CreatedAt}" /></VBox></CustomListItem>
                  </List>
                  <Button text="Load older messages" visible="{work>/moreMessages}" press=".onMoreMessages" />
                </VBox>
              </VBox>
            </IconTabFilter>
            <IconTabFilter text="Export history" icon="sap-icon://download">
              <Table items="{work>/jobs}" noDataText="No export jobs for this analysis.">
                <headerToolbar><OverflowToolbar><Title text="Export jobs" /><ToolbarSpacer /><Button text="Refresh" press=".onRefreshJobs" /></OverflowToolbar></headerToolbar>
                <columns><Column><Text text="File" /></Column><Column><Text text="Status" /></Column><Column><Text text="Created" /></Column><Column><Text text="Expires" /></Column><Column><Text text="Download" /></Column></columns>
                <items><ColumnListItem><cells><ObjectIdentifier title="{work>FileName}" text="{work>Message}" /><ObjectStatus text="{work>Status}" /><Text text="{work>CreatedAt}" /><Text text="{work>ExpiresAt}" /><Button icon="sap-icon://download" tooltip="Download export" press=".onDownloadJob" visible="{auth>/canExport}" enabled="{parts: [{path: 'work>Status'}, {path: 'work>ExpiresAt'}], formatter: '.isJobReady'}" /></cells></ColumnListItem></items>
              </Table>
              <Button text="Load more exports" visible="{work>/moreJobs}" press=".onMoreJobs" />
            </IconTabFilter>
          </items>
        </IconTabBar>
      </VBox>
    </content>
  </Page>
</mvc:View>
