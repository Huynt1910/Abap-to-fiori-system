<core:FragmentDefinition xmlns:core="sap.ui.core" xmlns="sap.m">
  <SelectDialog
    id="programValueHelpDialog"
    title="{i18n>selectProgram}"
    search=".onProgramValueHelpSearch"
    confirm=".onProgramValueHelpConfirm"
    cancel=".onProgramValueHelpConfirm"
    busy="{dashboard>/programValueHelpBusy}"
    busyIndicatorDelay="0"
    noDataText="{i18n>noPrograms}"
    items="{dashboard>/programValueHelp}">
    <StandardListItem
      title="{dashboard>RootProgram}"
      description="{dashboard>Description}"
      info="{dashboard>ProgramType}" />
  </SelectDialog>
</core:FragmentDefinition>
