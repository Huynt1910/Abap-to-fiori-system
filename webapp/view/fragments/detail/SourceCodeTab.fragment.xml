<core:FragmentDefinition xmlns:core="sap.ui.core" xmlns="sap.m">
  <VBox id="sourceCodeSurface" class="tabSurface sourceCodeSurface" busy="{detail>/loading/sourceObjects}" busyIndicatorDelay="0">
    <MessageStrip id="sourceObjectsErrorStrip" visible="{path: 'detail>/errors/sourceObjects', formatter: '.formatter.hasValue'}" text="{detail>/errors/sourceObjects}" type="Error" showIcon="true" class="sapUiSmallMarginBottom" />
    <OverflowToolbar class="sectionToolbar">
      <Title text="{i18n>sourceObject}" level="H3" />
      <ObjectStatus text="{path: 'detail>/counts/sourceObjects', formatter: '.formatter.formatCountText'}" />
    </OverflowToolbar>
    <FlexBox class="sourceCodeWorkspace" direction="Row" renderType="Div">
      <VBox class="sourceCodeObjectPane" visible="{= !${detail>/sourceObjectNarrow} || !${detail>/sourceCodeMobileDetail} }">
        <IllustratedMessage id="sourceObjectsEmptyMessage" visible="{= !${detail>/loading/sourceObjects} &amp;&amp; ${detail>/sourceObjects/length} === 0 }" illustrationType="sapIllus-NoEntries" illustrationSize="Spot" title="{i18n>noSourceObjects}" />
        <Tree
          id="sourceObjectTree"
          class="sourceObjectTree"
          mode="SingleSelectMaster"
          includeItemInSelection="true"
          visible="{= ${detail>/sourceObjects/length} > 0 }"
          noDataText="{i18n>noSourceObjects}"
          selectionChange=".onSourceObjectPress"
          toggleOpenState=".onSourceObjectToggleOpenState"
          updateFinished=".onSourceObjectTreeUpdateFinished"
          items="{path: 'detail>/sourceObjectTree', parameters: {arrayNames: ['children']}}"
        >
          <CustomTreeItem class="sourceObjectTreeItem">
            <HBox class="sourceObjectTreeItemContent" alignItems="Center" justifyContent="SpaceBetween">
              <HBox class="sourceObjectTreeIdentity" alignItems="Center">
                <core:Icon class="sourceObjectTreeIcon" src="{detail>icon}" decorative="true" />
                <VBox class="sourceObjectTreeText">
                  <Text class="sourceObjectTreeName" text="{detail>objectName}" tooltip="{detail>objectName}" wrapping="false" />
                  <Text class="sourceObjectTreeType" text="{detail>objectType}" tooltip="{detail>objectType}" wrapping="false" />
                </VBox>
              </HBox>
              <ObjectNumber class="sourceObjectTreeLineCount" number="{detail>lineCount}" tooltip="{= ${i18n>lineCount} + ': ' + ${detail>lineCount} }" />
            </HBox>
          </CustomTreeItem>
        </Tree>
      </VBox>
      <VBox class="sourceCodeViewerPane" visible="{= !${detail>/sourceObjectNarrow} || ${detail>/sourceCodeMobileDetail} }" busy="{detail>/sourceCodeDetail/loading}" busyIndicatorDelay="0">
        <Button id="sourceCodeBackButton" class="sourceCodeBackButton sapUiTinyMarginBottom" icon="sap-icon://nav-back" text="{i18n>backToSourceObjects}" tooltip="{i18n>backToSourceObjects}" visible="{detail>/sourceObjectNarrow}" press=".onBackToSourceObjectTree" />
        <MessageStrip id="sourceCodeErrorStrip" visible="{path: 'detail>/sourceCodeDetail/error', formatter: '.formatter.hasValue'}" text="{detail>/sourceCodeDetail/error}" type="Error" showIcon="true" class="sapUiSmallMarginBottom" />
        <IllustratedMessage visible="{= !${detail>/selectedSourceObject} }" illustrationType="sapIllus-SearchFolder" title="{i18n>selectSourceObject}" description="{i18n>selectSourceObjectDescription}" />
        <VBox visible="{= !!${detail>/selectedSourceObject} }">
          <ObjectIdentifier title="{path: 'detail>/selectedSourceObject/ObjectName', formatter: '.formatter.formatText'}" text="{path: 'detail>/selectedSourceObject/ObjectType', formatter: '.formatter.formatText'}" class="sapUiTinyMarginBottom" />
          <HBox wrap="Wrap" class="sourceCodeMetaLine sapUiSmallMarginBottom">
            <ObjectAttribute title="{i18n>parentObject}" text="{path: 'detail>/selectedSourceObject/ParentObject', formatter: '.formatter.formatText'}" />
            <ObjectAttribute title="{i18n>includeDepth}" text="{path: 'detail>/selectedSourceObject/IncludeDepth', formatter: '.formatter.formatNumber'}" />
            <ObjectAttribute title="{i18n>lineCount}" text="{path: 'detail>/selectedSourceObject/LineCount', formatter: '.formatter.formatNumber'}" />
          </HBox>
          <IllustratedMessage visible="{= !${detail>/sourceCodeDetail/loading} &amp;&amp; !${detail>/sourceCodeDetail/error} &amp;&amp; ${detail>/sourceCodeDetail/lines/length} === 0 }" illustrationType="sapIllus-NoEntries" illustrationSize="Spot" title="{i18n>noSourceLines}" />
          <Table id="sourceCodeLinesTable" showSeparators="None" class="sourceCodeTable" visible="{path: 'detail>/sourceCodeDetail/lines', formatter: '.formatter.hasItems'}" items="{detail>/sourceCodeDetail/lines}" growing="true" growingThreshold="100" sticky="ColumnHeaders">
            <columns>
              <Column width="5rem" hAlign="End"><Text text="{i18n>lineNumber}" /></Column>
              <Column><Text text="{i18n>sourceCode}" /></Column>
            </columns>
            <items>
              <ColumnListItem>
                <cells>
                  <ObjectNumber number="{detail>LineNumber}" class="sourceCodeLineNumber" />
                  <Text text="{detail>SourceText}" wrapping="false" class="sourceCodeText" />
                </cells>
              </ColumnListItem>
            </items>
          </Table>
        </VBox>
      </VBox>
    </FlexBox>
  </VBox>
</core:FragmentDefinition>
