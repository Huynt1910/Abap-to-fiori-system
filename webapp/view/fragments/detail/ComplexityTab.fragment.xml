<core:FragmentDefinition xmlns:core="sap.ui.core" xmlns="sap.m">
  <VBox class="tabSurface" busy="{detail>/loading/complexity}" busyIndicatorDelay="0">
    <MessageStrip
      visible="{path: 'detail>/errors/complexity', formatter: '.formatter.hasValue'}"
      text="{detail>/errors/complexity}"
      type="Error"
      showIcon="true"
      class="sapUiSmallMarginBottom">
      <link>
        <Link text="{i18n>retry}" press=".onRetryComplexity" />
      </link>
    </MessageStrip>
    <IllustratedMessage
      visible="{= !${detail>/complexity} &amp;&amp; !${detail>/errors/complexity} }"
      illustrationType="sapIllus-NoData"
      title="{i18n>noComplexityTitle}"
      description="{i18n>noComplexityDescription}" />
    <VBox visible="{= !!${detail>/complexity} }" class="complexityLayout">
      <VBox id="complexitySummary" class="overviewCard complexitySummary">
        <HBox alignItems="Center" class="cardHeader">
          <core:Icon src="sap-icon://performance" />
          <Title text="{i18n>complexityTabTitle}" level="H3" />
        </HBox>
        <ObjectNumber number="{path: 'detail>/complexity/OverallScore', formatter: '.formatter.formatScoreText'}" unit="{i18n>overallScore}" />
        <ObjectStatus
          title="{i18n>complexityLevel}"
          text="{path: 'detail>/complexity/ComplexityLevel', formatter: '.formatter.formatText'}"
          state="{path: 'detail>/complexity/ComplexityLevel', formatter: '.formatter.formatComplexityState'}" />
      </VBox>
      <FlexBox id="complexityScoreGrid" wrap="Wrap" class="overviewCardGrid">
        <VBox class="scoreCard"><Label text="{i18n>sourceScore}" /><ObjectNumber number="{path: 'detail>/complexity/SourceScore', formatter: '.formatter.formatScoreText'}" /></VBox>
        <VBox class="scoreCard"><Label text="{i18n>databaseScore}" /><ObjectNumber number="{path: 'detail>/complexity/DatabaseScore', formatter: '.formatter.formatScoreText'}" /></VBox>
        <VBox class="scoreCard"><Label text="{i18n>callScore}" /><ObjectNumber number="{path: 'detail>/complexity/CallScore', formatter: '.formatter.formatScoreText'}" /></VBox>
        <VBox class="scoreCard"><Label text="{i18n>routineScore}" /><ObjectNumber number="{path: 'detail>/complexity/RoutineScore', formatter: '.formatter.formatScoreText'}" /></VBox>
        <VBox class="scoreCard"><Label text="{i18n>flowScore}" /><ObjectNumber number="{path: 'detail>/complexity/FlowScore', formatter: '.formatter.formatScoreText'}" /></VBox>
        <VBox class="scoreCard"><Label text="{i18n>issueScore}" /><ObjectNumber number="{path: 'detail>/complexity/IssueScore', formatter: '.formatter.formatScoreText'}" /></VBox>
      </FlexBox>
      <HBox wrap="Wrap" class="detailMetaLine">
        <ObjectAttribute title="{i18n>scoringVersion}" text="{path: 'detail>/complexity/ScoringVersion', formatter: '.formatter.formatText'}" />
        <ObjectAttribute title="{i18n>assessedAt}" text="{path: 'detail>/complexity/AssessedAt', formatter: '.formatter.formatDateTime'}" />
      </HBox>
    </VBox>
  </VBox>
</core:FragmentDefinition>
