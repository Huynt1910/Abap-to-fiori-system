<core:FragmentDefinition xmlns:core="sap.ui.core" xmlns="sap.m">
  <VBox class="tabSurface" busy="{detail>/loading/evidences}" busyIndicatorDelay="0">
    <MessageStrip visible="{path: 'detail>/errors/evidences', formatter: '.formatter.hasValue'}" text="{detail>/errors/evidences}" type="Error" showIcon="true" class="sapUiSmallMarginBottom" />
    <OverflowToolbar class="sectionToolbar" visible="{path: 'detail>/evidences', formatter: '.formatter.hasItems'}">
      <Title text="{i18n>evidence}" level="H3" />
      <ObjectStatus text="{path: 'detail>/counts/evidences', formatter: '.formatter.formatCountText'}" />
      <ToolbarSpacer />
    </OverflowToolbar>
    <IllustratedMessage visible="{path: 'detail>/evidences', formatter: '.formatter.hasNoItems'}" illustrationType="sapIllus-NoEntries" title="{i18n>noEvidences}" />
    <Table id="evidencesTable" visible="{path: 'detail>/evidences', formatter: '.formatter.hasItems'}" growing="true" growingThreshold="20" items="{detail>/evidences}" itemPress=".onEvidencePress">
      <columns>
        <Column width="12rem"><Text text="{i18n>sourceObject}" /></Column>
        <Column width="6rem" hAlign="End"><Text text="{i18n>startLine}" /></Column>
        <Column width="6rem" hAlign="End"><Text text="{i18n>endLine}" /></Column>
        <Column width="12rem"><Text text="{i18n>statementId}" /></Column>
        <Column><Text text="{i18n>statementText}" /></Column>
      </columns>
      <items>
        <ColumnListItem type="Active" press=".onEvidencePress">
          <cells>
            <Text text="{path: 'detail>SourceObject', formatter: '.formatter.formatText'}" />
            <ObjectNumber number="{path: 'detail>StartLine', formatter: '.formatter.formatNumber'}" />
            <ObjectNumber number="{path: 'detail>EndLine', formatter: '.formatter.formatNumber'}" />
            <Text text="{path: 'detail>StatementId', formatter: '.formatter.formatText'}" />
            <Text text="{path: 'detail>StatementText', formatter: '.formatter.formatText'}" maxLines="2" wrapping="true" />
          </cells>
        </ColumnListItem>
      </items>
    </Table>
  </VBox>
</core:FragmentDefinition>
