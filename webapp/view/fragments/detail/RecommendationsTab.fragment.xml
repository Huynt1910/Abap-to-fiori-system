<core:FragmentDefinition xmlns:core="sap.ui.core" xmlns="sap.m">
  <VBox class="tabSurface" busy="{detail>/loading/recommendations}" busyIndicatorDelay="0">
    <MessageStrip
      visible="{path: 'detail>/errors/recommendations', formatter: '.formatter.hasValue'}"
      text="{detail>/errors/recommendations}"
      type="Error"
      showIcon="true"
      class="sapUiSmallMarginBottom">
      <link>
        <Link text="{i18n>retry}" press=".onRetryRecommendations" />
      </link>
    </MessageStrip>
    <OverflowToolbar class="sectionToolbar" visible="{path: 'detail>/recommendations', formatter: '.formatter.hasItems'}">
      <Title text="{i18n>recommendationsTabTitle}" level="H3" />
      <ObjectStatus text="{path: 'detail>/counts/recommendations', formatter: '.formatter.formatCountText'}" />
      <ToolbarSpacer />
    </OverflowToolbar>
    <IllustratedMessage
      visible="{= !${detail>/errors/recommendations} &amp;&amp; ${detail>/recommendations}.length === 0 }"
      illustrationType="sapIllus-NoEntries"
      title="{i18n>noRecommendationsTitle}"
      description="{i18n>noRecommendationsDescription}" />
    <Table
      id="recommendationsTable"
      visible="{path: 'detail>/recommendations', formatter: '.formatter.hasItems'}"
      growing="true"
      growingThreshold="20"
      items="{detail>/recommendations}"
      itemPress=".onRecommendationPress">
      <columns>
        <Column width="8rem"><Text text="{i18n>severity}" /></Column>
        <Column width="10rem"><Text text="{i18n>targetLayer}" /></Column>
        <Column><Text text="{i18n>title}" /></Column>
        <Column width="12rem" demandPopin="true" minScreenWidth="Tablet"><Text text="{i18n>ruleId}" /></Column>
        <Column width="8rem" demandPopin="true" minScreenWidth="Desktop"><Text text="{i18n>confidence}" /></Column>
      </columns>
      <items>
        <ColumnListItem type="Active" press=".onRecommendationPress">
          <cells>
            <ObjectStatus text="{path: 'detail>Severity', formatter: '.formatter.formatText'}" state="{path: 'detail>Severity', formatter: '.formatter.formatSeverityState'}" icon="sap-icon://flag" />
            <Text text="{path: 'detail>TargetLayer', formatter: '.formatter.formatText'}" />
            <Text text="{path: 'detail>Title', formatter: '.formatter.formatText'}" maxLines="2" wrapping="true" />
            <Text text="{path: 'detail>RuleId', formatter: '.formatter.formatText'}" />
            <ObjectNumber number="{path: 'detail>Confidence', formatter: '.formatter.formatScoreText'}" />
          </cells>
        </ColumnListItem>
      </items>
    </Table>
  </VBox>
</core:FragmentDefinition>
