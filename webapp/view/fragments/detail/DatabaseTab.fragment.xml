<core:FragmentDefinition xmlns:core="sap.ui.core" xmlns="sap.m">
  <VBox class="tabSurface" busy="{detail>/loading/databaseObjects}" busyIndicatorDelay="0">
    <MessageStrip visible="{path: 'detail>/errors/databaseObjects', formatter: '.formatter.hasValue'}" text="{detail>/errors/databaseObjects}" type="Error" showIcon="true" class="sapUiSmallMarginBottom" />
    <OverflowToolbar class="sectionToolbar" visible="{path: 'detail>/databaseObjects', formatter: '.formatter.hasItems'}">
      <Title text="{i18n>databaseObjects}" level="H3" />
      <ObjectStatus text="{path: 'detail>/counts/databaseObjects', formatter: '.formatter.formatCountText'}" />
      <ToolbarSpacer />
    </OverflowToolbar>
    <IllustratedMessage visible="{path: 'detail>/databaseObjects', formatter: '.formatter.hasNoItems'}" illustrationType="sapIllus-NoEntries" title="{i18n>noDatabaseAccesses}" />
    <Table id="databaseObjectsTable" visible="{path: 'detail>/databaseObjects', formatter: '.formatter.hasItems'}" growing="true" growingThreshold="20" items="{detail>/databaseObjects}" itemPress=".onDatabaseObjectPress">
      <columns>
        <Column width="12rem"><Text text="{i18n>objectName}" /></Column>
        <Column width="8rem"><Text text="{i18n>objectType}" /></Column>
        <Column width="10rem" demandPopin="true" minScreenWidth="Tablet"><Text text="{i18n>operation}" /></Column>
        <Column width="14rem" demandPopin="true" minScreenWidth="Tablet"><Text text="{i18n>containingRoutine}" /></Column>
        <Column width="10rem"><Text text="{i18n>pagingCapability}" /></Column>
        <Column width="8rem"><Text text="{i18n>confidence}" /></Column>
      </columns>
      <items>
        <ColumnListItem type="Active" press=".onDatabaseObjectPress">
          <cells>
            <Text text="{path: 'detail>ObjectName', formatter: '.formatter.formatText'}" />
            <Text text="{path: 'detail>ObjectType', formatter: '.formatter.formatText'}" />
            <Text text="{path: 'detail>Operation', formatter: '.formatter.formatText'}" />
            <Text text="{path: 'detail>ContainingRoutine', formatter: '.formatter.formatText'}" />
            <Text text="{path: 'detail>PagingCapability', formatter: '.formatter.formatText'}" />
            <Text text="{path: 'detail>Confidence', formatter: '.formatter.formatText'}" />
          </cells>
        </ColumnListItem>
      </items>
    </Table>
  </VBox>
</core:FragmentDefinition>
