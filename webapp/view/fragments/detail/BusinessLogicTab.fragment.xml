<core:FragmentDefinition xmlns:core="sap.ui.core" xmlns="sap.m">
  <VBox class="tabSurface" busy="{detail>/loading/businessLogic}" busyIndicatorDelay="0">
    <MessageStrip visible="{path: 'detail>/errors/businessLogic', formatter: '.formatter.hasValue'}" text="{detail>/errors/businessLogic}" type="Error" showIcon="true" class="sapUiSmallMarginBottom" />
    <OverflowToolbar class="sectionToolbar" visible="{path: 'detail>/businessLogic', formatter: '.formatter.hasItems'}">
      <Title text="{i18n>businessLogic}" level="H3" />
      <ObjectStatus text="{path: 'detail>/counts/businessLogic', formatter: '.formatter.formatCountText'}" />
      <ToolbarSpacer />
    </OverflowToolbar>
    <IllustratedMessage visible="{path: 'detail>/businessLogic', formatter: '.formatter.hasNoItems'}" illustrationType="sapIllus-NoEntries" title="{i18n>noBusinessLogic}" />
    <Table id="businessLogicTable" visible="{path: 'detail>/businessLogic', formatter: '.formatter.hasItems'}" growing="true" growingThreshold="20" items="{detail>/businessLogic}" itemPress=".onBusinessLogicPress">
      <columns>
        <Column width="12rem"><Text text="{i18n>objectName}" /></Column>
        <Column width="9rem"><Text text="{i18n>objectType}" /></Column>
        <Column width="12rem" demandPopin="true" minScreenWidth="Tablet"><Text text="{i18n>containerName}" /></Column>
        <Column width="12rem" demandPopin="true" minScreenWidth="Tablet"><Text text="{i18n>callingRoutine}" /></Column>
        <Column width="10rem" demandPopin="true" minScreenWidth="Desktop"><Text text="{i18n>reuseFeasibility}" /></Column>
        <Column width="8rem"><Text text="{i18n>confidence}" /></Column>
      </columns>
      <items>
        <ColumnListItem type="Active" press=".onBusinessLogicPress">
          <cells>
            <Text text="{path: 'detail>ObjectName', formatter: '.formatter.formatText'}" />
            <Text text="{path: 'detail>ObjectType', formatter: '.formatter.formatText'}" />
            <Text text="{path: 'detail>ContainerName', formatter: '.formatter.formatText'}" />
            <Text text="{path: 'detail>CallingRoutine', formatter: '.formatter.formatText'}" />
            <Text text="{path: 'detail>ReuseFeasibility', formatter: '.formatter.formatText'}" />
            <Text text="{path: 'detail>Confidence', formatter: '.formatter.formatText'}" />
          </cells>
        </ColumnListItem>
      </items>
    </Table>
  </VBox>
</core:FragmentDefinition>
