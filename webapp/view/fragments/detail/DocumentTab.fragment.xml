<core:FragmentDefinition xmlns:core="sap.ui.core" xmlns="sap.m">
  <VBox class="tabSurface documentBlock">
    <IllustratedMessage visible="{= !${detail>/document/FileName} }" illustrationType="sapIllus-NoData" title="{i18n>noDocument}" />
    <VBox visible="{= !!${detail>/document/FileName} }" class="documentCard">
      <ObjectIdentifier title="{detail>/document/FileName}" text="{path: 'detail>/document/GeneratedAt', formatter: '.formatter.formatDateTime'}" />
      <ObjectAttribute title="{i18n>mimeType}" text="{path: 'detail>/document/MimeType', formatter: '.formatter.formatText'}" />
      <ObjectAttribute title="{i18n>lines}" text="{path: 'detail>/document/LineCount', formatter: '.formatter.formatNumber'}" />
      <ObjectAttribute title="{i18n>chunks}" text="{path: 'detail>/document/ChunkCount', formatter: '.formatter.formatNumber'}" />
    </VBox>
    <Toolbar design="Transparent">
      <Button text="{i18n>download}" icon="sap-icon://download" enabled="{= !!${detail>/document/FileName} }" press=".onDownloadDocument" />
      <Button text="{i18n>generateAgain}" icon="sap-icon://document" enabled="{= !!${detail>/overview/__OperationControl/GenerateDocument} }" press=".onGenerateDocument" />
    </Toolbar>
  </VBox>
</core:FragmentDefinition>
