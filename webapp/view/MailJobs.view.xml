<mvc:View
    controllerName="abap.to.fiori.system.controller.MailJobs"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns:core="sap.ui.core"
    xmlns:f="sap.f"
    xmlns="sap.m"
    displayBlock="true"
>
    <f:DynamicPage
        id="mailJobsPage"
        busy="{mailUi>/listBusy}"
        busyIndicatorDelay="0"
        class="migrationAnalyzerPage"
    >
        <f:title>
            <f:DynamicPageTitle>
                <f:heading>
                    <HBox class="pageTitleWithBack">
                        <Button
                            type="Transparent"
                            icon="sap-icon://nav-back"
                            press=".onBackToDashboard"
                        />
                        <Title
                            text="{i18n>mailDistributionTitle}"
                            level="H2"
                        />
                    </HBox>
                </f:heading>
                <f:actions>
                    <Button
                        text="{i18n>refresh}"
                        type="Transparent"
                        icon="sap-icon://refresh"
                        press=".onRefresh"
                    />
                </f:actions>
            </f:DynamicPageTitle>
        </f:title>
        <f:header>
            <f:DynamicPageHeader pinnable="false">
                <HBox
                    alignItems="End"
                    wrap="Wrap"
                    class="migrationAnalyzerFilterBar mailJobsFilterBar"
                >
                    <VBox
                        class="migrationAnalyzerFilterField migrationAnalyzerSearchFilterField"
                    >
                        <Label
                            text="{i18n>search}"
                            labelFor="mailJobSearch"
                        />
                        <SearchField
                            id="mailJobSearch"
                            value="{mailUi>/filters/search}"
                            placeholder="{i18n>searchMailJobs}"
                            search=".onSearch"
                        />
                    </VBox>
                    <VBox
                        class="migrationAnalyzerFilterField migrationAnalyzerSelectFilterField"
                    >
                        <Label
                            text="{i18n>frequency}"
                            labelFor="mailFrequencySelect"
                        />
                        <Select
                            id="mailFrequencySelect"
                            selectedKey="{mailUi>/filters/frequency}"
                            change=".onSearch"
                        >
                            <items>
                                <core:Item
                                    key=""
                                    text="{i18n>allFrequencies}"
                                />
                                <core:Item
                                    key="O"
                                    text="{i18n>frequencyOnDemand}"
                                />
                                <core:Item
                                    key="D"
                                    text="{i18n>frequencyDaily}"
                                />
                                <core:Item
                                    key="W"
                                    text="{i18n>frequencyWeekly}"
                                />
                                <core:Item
                                    key="M"
                                    text="{i18n>frequencyMonthly}"
                                />
                            </items>
                        </Select>
                    </VBox>
                    <VBox
                        class="migrationAnalyzerFilterField migrationAnalyzerSelectFilterField"
                    >
                        <Label
                            text="{i18n>exportFileFormat}"
                            labelFor="mailFormatSelect"
                        />
                        <Select
                            id="mailFormatSelect"
                            selectedKey="{mailUi>/filters/fileFormat}"
                            change=".onSearch"
                        >
                            <items>
                                <core:Item
                                    key=""
                                    text="{i18n>allFileFormats}"
                                />
                                <core:Item
                                    key="X"
                                    text="{i18n>exportFormatExcel}"
                                />
                                <core:Item
                                    key="P"
                                    text="{i18n>exportFormatPdf}"
                                />
                                <core:Item
                                    key="C"
                                    text="{i18n>exportFormatCsv}"
                                />
                            </items>
                        </Select>
                    </VBox>
                    <Button
                        type="Transparent"
                        icon="sap-icon://action-settings"
                        tooltip="{i18n>viewSettings}"
                        press=".onOpenMailTableSettings"
                    />
                </HBox>
            </f:DynamicPageHeader>
        </f:header>
        <f:content>
            <VBox class="migrationAnalyzerContent">
                <Table
                    id="mailJobsTable"
                    growing="true"
                    growingThreshold="20"
                    sticky="ColumnHeaders"
                    autoPopinMode="true"
                    updateFinished=".onMailJobsUpdateFinished"
                    items="{path: 'mail>/MailJobs', sorter: { path: 'CreatedAt', descending: true }, parameters: { $$groupId: '$direct', $select: 'JobId,AnalysisId,JobName,ReportType,FileFormat,Frequency,StartDate,StartTime,DayOfWeek,DayOfMonth,NextRunAt,MailSubject,MailBody,Status,CreatedBy,CreatedAt,LocalLastChangedAt' }}"
                >
                    <noData>
                        <IllustratedMessage
                            illustrationType="sapIllus-NoEntries"
                            title="{i18n>noMailJobs}"
                            description="{i18n>noMailJobsDescription}"
                        />
                    </noData>
                    <columns>
                        <Column
                            width="14rem"
                            importance="High"
                            visible="{mailUi>/columns/jobName}"
                        >
                            <Text text="{i18n>mailJobName}" />
                        </Column>
                        <Column
                            width="10rem"
                            demandPopin="true"
                            minScreenWidth="Tablet"
                            visible="{mailUi>/columns/reportType}"
                        >
                            <Text text="{i18n>reportType}" />
                        </Column>
                        <Column
                            width="8rem"
                            demandPopin="true"
                            minScreenWidth="Tablet"
                            visible="{mailUi>/columns/fileFormat}"
                        >
                            <Text text="{i18n>exportFileFormat}" />
                        </Column>
                        <Column
                            width="8rem"
                            demandPopin="true"
                            minScreenWidth="Tablet"
                            visible="{mailUi>/columns/frequency}"
                        >
                            <Text text="{i18n>frequency}" />
                        </Column>
                        <Column
                            width="12rem"
                            demandPopin="true"
                            minScreenWidth="Desktop"
                            visible="{mailUi>/columns/nextRunAt}"
                        >
                            <Text text="{i18n>nextRunAt}" />
                        </Column>
                        <Column
                            width="7rem"
                            hAlign="End"
                            demandPopin="true"
                            minScreenWidth="Desktop"
                            visible="{mailUi>/columns/recipientCount}"
                        >
                            <Text text="{i18n>recipientCount}" />
                        </Column>
                        <Column
                            width="9rem"
                            demandPopin="true"
                            minScreenWidth="Desktop"
                            visible="{mailUi>/columns/createdBy}"
                        >
                            <Text text="{i18n>createdBy}" />
                        </Column>
                        <Column
                            width="12rem"
                            demandPopin="true"
                            minScreenWidth="Desktop"
                            visible="{mailUi>/columns/createdAt}"
                        >
                            <Text text="{i18n>createdAt}" />
                        </Column>
                        <Column
                            width="18rem"
                            importance="High"
                            visible="{mailUi>/columns/actions}"
                        >
                            <Text text="{i18n>actions}" />
                        </Column>
                    </columns>
                    <items>
                        <ColumnListItem>
                            <cells>
                                <ObjectIdentifier
                                    title="{path: 'mail>JobName', formatter: '.mailFormatter.formatText'}"
                                    visible="{mailUi>/columns/jobName}"
                                />
                                <Text
                                    text="{path: 'mail>ReportType', formatter: '.mailFormatter.formatText'}"
                                    visible="{mailUi>/columns/reportType}"
                                />
                                <Text
                                    text="{path: 'mail>FileFormat', formatter: '.mailFormatter.formatFileFormat'}"
                                    visible="{mailUi>/columns/fileFormat}"
                                />
                                <Text
                                    text="{path: 'mail>Frequency', formatter: '.mailFormatter.formatFrequency'}"
                                    visible="{mailUi>/columns/frequency}"
                                />
                                <Text
                                    text="{path: 'mail>NextRunAt', formatter: '.mailFormatter.formatDateTime'}"
                                    visible="{mailUi>/columns/nextRunAt}"
                                />
                                <ObjectNumber
                                    number="{path: 'mail>JobId', formatter: '.formatRecipientCountForJob'}"
                                    visible="{mailUi>/columns/recipientCount}"
                                />
                                <Text
                                    text="{path: 'mail>CreatedBy', formatter: '.mailFormatter.formatText'}"
                                    visible="{mailUi>/columns/createdBy}"
                                />
                                <Text
                                    text="{path: 'mail>CreatedAt', formatter: '.mailFormatter.formatDateTime'}"
                                    visible="{mailUi>/columns/createdAt}"
                                />
                                <OverflowToolbar
                                    class="mailActionToolbar"
                                    visible="{mailUi>/columns/actions}"
                                >
                                    <Button
                                        icon="sap-icon://display"
                                        tooltip="{i18n>viewDetails}"
                                        press=".onViewDetails"
                                    />
                                    <Button
                                        icon="sap-icon://edit"
                                        tooltip="{i18n>edit}"
                                        press=".onEditMailJob"
                                    />
                                    <Button
                                        icon="sap-icon://add-contact"
                                        tooltip="{i18n>addRecipient}"
                                        press=".onAddRecipient"
                                    />
                                    <Button
                                        icon="sap-icon://email"
                                        tooltip="{i18n>sendNow}"
                                        press=".onSendNow"
                                        enabled="{parts: [{path: 'mail>JobId', targetType: 'any'}, {path: 'mailUi>/sendBusyJobId', targetType: 'any'}], formatter: '.canSendNowForJob'}"
                                    />
                                    <Button
                                        icon="sap-icon://delete"
                                        tooltip="{i18n>delete}"
                                        type="Transparent"
                                        press=".onDeleteMailJob"
                                    />
                                </OverflowToolbar>
                            </cells>
                        </ColumnListItem>
                    </items>
                </Table>
            </VBox>
        </f:content>
    </f:DynamicPage>
</mvc:View>
