<mvc:View
  controllerName="abap.to.fiori.system.controller.MailJobs"
  xmlns:mvc="sap.ui.core.mvc"
  xmlns:core="sap.ui.core"
  xmlns:f="sap.f"
  xmlns="sap.m"
  displayBlock="true">
  <f:DynamicPage id="mailJobsPage" busy="{mailUi>/listBusy}" busyIndicatorDelay="0" class="migrationAnalyzerPage">
    <f:title>
      <f:DynamicPageTitle>
        <f:heading>
          <Title text="{i18n>mailDistributionTitle}" level="H2" />
        </f:heading>
        <f:actions>
          <Button text="{i18n>back}" type="Transparent" icon="sap-icon://nav-back" press=".onBackToDashboard" />
          <Button text="{i18n>refresh}" type="Transparent" icon="sap-icon://refresh" press=".onRefresh" />
        </f:actions>
      </f:DynamicPageTitle>
    </f:title>
    <f:header>
      <f:DynamicPageHeader pinnable="false">
        <HBox alignItems="End" wrap="Wrap" class="migrationAnalyzerFilterBar">
          <VBox class="migrationAnalyzerFilterField">
            <Label text="{i18n>search}" labelFor="mailJobSearch" />
            <SearchField id="mailJobSearch" value="{mailUi>/filters/search}" placeholder="{i18n>searchMailJobs}" search=".onSearch" />
          </VBox>
          <VBox class="migrationAnalyzerFilterField">
            <Label text="{i18n>frequency}" labelFor="mailFrequencySelect" />
            <Select id="mailFrequencySelect" selectedKey="{mailUi>/filters/frequency}" change=".onSearch">
              <items>
                <core:Item key="" text="{i18n>allFrequencies}" />
                <core:Item key="O" text="{i18n>frequencyOnDemand}" />
                <core:Item key="D" text="{i18n>frequencyDaily}" />
                <core:Item key="W" text="{i18n>frequencyWeekly}" />
                <core:Item key="M" text="{i18n>frequencyMonthly}" />
              </items>
            </Select>
          </VBox>
          <VBox class="migrationAnalyzerFilterField">
            <Label text="{i18n>exportFileFormat}" labelFor="mailFormatSelect" />
            <Select id="mailFormatSelect" selectedKey="{mailUi>/filters/fileFormat}" change=".onSearch">
              <items>
                <core:Item key="" text="{i18n>allFileFormats}" />
                <core:Item key="X" text="{i18n>exportFormatExcel}" />
                <core:Item key="P" text="{i18n>exportFormatPdf}" />
                <core:Item key="C" text="{i18n>exportFormatCsv}" />
              </items>
            </Select>
          </VBox>
          <Button text="{i18n>go}" type="Emphasized" icon="sap-icon://accept" press=".onSearch" />
          <Button text="{i18n>clearFilters}" icon="sap-icon://clear-filter" press=".onClearFilters" />
        </HBox>
      </f:DynamicPageHeader>
    </f:header>
    <f:content>
      <VBox class="migrationAnalyzerContent">
        <Table
          id="mailJobsTable"
          growing="true"
          growingThreshold="20"
          sticky="ColumnHeaders"
          autoPopinMode="true"
          updateFinished=".onMailJobsUpdateFinished"
          items="{path: 'mail>/MailJobs', parameters: { $$groupId: '$direct' }}">
          <noData>
            <IllustratedMessage illustrationType="sapIllus-NoEntries" title="{i18n>noMailJobs}" description="{i18n>noMailJobsDescription}" />
          </noData>
          <columns>
            <Column width="14rem" importance="High"><Text text="{i18n>mailJobName}" /></Column>
            <Column width="10rem" demandPopin="true" minScreenWidth="Tablet"><Text text="{i18n>reportType}" /></Column>
            <Column width="8rem" demandPopin="true" minScreenWidth="Tablet"><Text text="{i18n>exportFileFormat}" /></Column>
            <Column width="8rem" demandPopin="true" minScreenWidth="Tablet"><Text text="{i18n>frequency}" /></Column>
            <Column width="12rem" demandPopin="true" minScreenWidth="Desktop"><Text text="{i18n>nextRunAt}" /></Column>
            <Column width="7rem" hAlign="End" demandPopin="true" minScreenWidth="Desktop"><Text text="{i18n>recipientCount}" /></Column>
            <Column width="9rem" demandPopin="true" minScreenWidth="Desktop"><Text text="{i18n>createdBy}" /></Column>
            <Column width="12rem" demandPopin="true" minScreenWidth="Desktop"><Text text="{i18n>createdAt}" /></Column>
            <Column width="18rem" importance="High"><Text text="{i18n>actions}" /></Column>
          </columns>
          <items>
            <ColumnListItem>
              <cells>
                <ObjectIdentifier title="{path: 'mail>JobName', formatter: '.mailFormatter.formatText'}" />
                <Text text="{path: 'mail>ReportType', formatter: '.mailFormatter.formatText'}" />
                <Text text="{path: 'mail>FileFormat', formatter: '.mailFormatter.formatFileFormat'}" />
                <Text text="{path: 'mail>Frequency', formatter: '.mailFormatter.formatFrequency'}" />
                <Text text="{path: 'mail>NextRunAt', formatter: '.mailFormatter.formatDateTime'}" />
                <ObjectNumber number="{path: 'mail>JobId', formatter: '.formatRecipientCountForJob'}" />
                <Text text="{path: 'mail>CreatedBy', formatter: '.mailFormatter.formatText'}" />
                <Text text="{path: 'mail>CreatedAt', formatter: '.mailFormatter.formatDateTime'}" />
                <OverflowToolbar class="mailActionToolbar">
                  <Button icon="sap-icon://display" tooltip="{i18n>viewDetails}" press=".onViewDetails" />
                  <Button icon="sap-icon://edit" tooltip="{i18n>edit}" press=".onEditMailJob" />
                  <Button icon="sap-icon://add-contact" tooltip="{i18n>addRecipient}" press=".onAddRecipient" />
                  <Button
                    icon="sap-icon://email"
                    tooltip="{i18n>sendNow}"
                    press=".onSendNow"
                    enabled="{parts: [{path: 'mail>JobId', targetType: 'any'}, {path: 'mailUi>/sendBusyJobId', targetType: 'any'}], formatter: '.canSendNowForJob'}" />
                  <Button icon="sap-icon://delete" tooltip="{i18n>delete}" type="Transparent" press=".onDeleteMailJob" />
                </OverflowToolbar>
              </cells>
            </ColumnListItem>
          </items>
        </Table>
      </VBox>
    </f:content>
  </f:DynamicPage>
</mvc:View>
