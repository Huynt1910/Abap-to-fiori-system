{
  "_version": "1.65.0",
  "sap.app": {
    "id": "abap.to.fiori.system",
    "type": "application",
    "i18n": "i18n/i18n.properties",
    "applicationVersion": {
      "version": "1.0.0"
    },
    "title": "{{appTitle}}",
    "description": "{{appDescription}}",
    "dataSources": {
      "mainService": {
        "uri": "/sap/opu/odata4/sap/zui_mig_analysis_o4/srvd/sap/zui_mig_analysis/0001/?sap-client=324",
        "type": "OData",
        "settings": {
          "odataVersion": "4.0"
        }
      },
      "mailService": {
        "uri": "/sap/opu/odata4/sap/zui_mig_mail_ov4/srvd/sap/zui_mig_mail/0001/?sap-client=324",
        "type": "OData",
        "settings": {
          "odataVersion": "4.0"
        }
      },
      "comparisonService": {
        "uri": "/sap/opu/odata4/sap/zui_mig_cmp_o4/srvd/sap/zui_mig_cmp/0001/?sap-client=324",
        "type": "OData",
        "settings": {
          "odataVersion": "4.0"
        }
      }
    },
    "crossNavigation": {
      "inbounds": {
        "display": {
          "semanticObject": "ABAPMigrationAnalyzer",
          "action": "display",
          "title": "{{appTitle}}",
          "signature": {
            "parameters": {},
            "additionalParameters": "allowed"
          }
        }
      }
    }
  },
  "sap.ui": {
    "technology": "UI5",
    "icons": {
      "icon": "sap-icon://business-objects-experience"
    },
    "deviceTypes": {
      "desktop": true,
      "tablet": true,
      "phone": true
    }
  },
  "sap.ui5": {
    "rootView": {
      "viewName": "abap.to.fiori.system.view.App",
      "type": "XML",
      "id": "app",
      "async": true
    },
    "dependencies": {
      "minUI5Version": "1.120.0",
      "libs": {
        "sap.m": {},
        "sap.ui.core": {},
        "sap.f": {},
        "sap.ui.layout": {},
        "sap.uxap": {}
      }
    },
    "contentDensities": {
      "compact": true,
      "cozy": true
    },
    "models": {
      "i18n": {
        "type": "sap.ui.model.resource.ResourceModel",
        "settings": {
          "bundleName": "abap.to.fiori.system.i18n.i18n",
          "supportedLocales": [""],
          "fallbackLocale": ""
        }
      },
      "": {
        "dataSource": "mainService",
        "type": "sap.ui.model.odata.v4.ODataModel",
        "preload": true,
        "settings": {
          "operationMode": "Server",
          "synchronizationMode": "None",
          "autoExpandSelect": true,
          "earlyRequests": true,
          "groupId": "$auto",
          "updateGroupId": "$auto"
        }
      },
      "mail": {
        "dataSource": "mailService",
        "type": "sap.ui.model.odata.v4.ODataModel",
        "preload": true,
        "settings": {
          "operationMode": "Server",
          "synchronizationMode": "None",
          "autoExpandSelect": true,
          "earlyRequests": true,
          "groupId": "$direct",
          "updateGroupId": "$direct"
        }
      },
      "comparison": {
        "dataSource": "comparisonService",
        "type": "sap.ui.model.odata.v4.ODataModel",
        "preload": true,
        "settings": {
          "operationMode": "Server",
          "synchronizationMode": "None",
          "autoExpandSelect": true,
          "earlyRequests": true,
          "groupId": "$direct",
          "updateGroupId": "$direct"
        }
      }
    },
    "resources": {
      "css": [
        {
          "uri": "css/style.css"
        }
      ]
    },
    "routing": {
      "config": {
        "routerClass": "sap.m.routing.Router",
        "type": "View",
        "viewType": "XML",
        "path": "abap.to.fiori.system.view",
        "controlId": "app",
        "controlAggregation": "pages",
        "async": true,
        "bypassed": {
          "target": "dashboard"
        }
      },
      "routes": [
        {
          "name": "dashboard",
          "pattern": "",
          "target": "dashboard"
        },
        {
          "name": "analysisDetail",
          "pattern": "analysis/{analysisId}",
          "target": "analysisDetail"
        },
        {
          "name": "alvOutputDetail",
          "pattern": "analysis/{analysisId}/alv-output/{outputId}",
          "target": "alvOutputDetail"
        },
        {
          "name": "recommendationDetail",
          "pattern": "analysis/{analysisId}/recommendation/{recommendationId}",
          "target": "recommendationDetail"
        },
        {
          "name": "detail",
          "pattern": "detail/{analysisId}",
          "target": "analysisDetail"
        },
        {
          "name": "mailJobs",
          "pattern": "mail",
          "target": "mailJobs"
        },
        {
          "name": "mailJobsSlash",
          "pattern": "/mail",
          "target": "mailJobs"
        },
        {
          "name": "mailJobDetail",
          "pattern": "mail/{jobId}",
          "target": "mailJobDetail"
        },
        {
          "name": "mailJobDetailSlash",
          "pattern": "/mail/{jobId}",
          "target": "mailJobDetail"
        },
        {
          "name": "comparisonHistory",
          "pattern": "comparison",
          "target": "comparisonHistory"
        },
        {
          "name": "comparisonDetail",
          "pattern": "comparison/{cmpRunId}",
          "target": "comparisonDetail"
        }
      ],
      "targets": {
        "dashboard": {
          "viewName": "Dashboard"
        },
        "analysisDetail": {
          "viewName": "AnalysisDetail"
        },
        "alvOutputDetail": {
          "viewName": "AlvOutputDetail"
        },
        "recommendationDetail": {
          "viewName": "RecommendationDetail"
        },
        "mailJobs": {
          "viewName": "MailJobs"
        },
        "mailJobDetail": {
          "viewName": "MailJobDetail"
        },
        "comparisonHistory": {
          "viewName": "ComparisonList"
        },
        "comparisonDetail": {
          "viewName": "ComparisonDetail"
        }
      }
    }
  },
  "sap.fiori": {
    "registrationIds": [],
    "archeType": "analytical"
  }
}
